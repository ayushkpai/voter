<div class="min-h-screen w-full bg-gray-100 flex items-center justify-center p-4 sm:p-8">
  <div class="w-full max-w-6xl min-h-[90vh] bg-gradient-to-br from-slate-900 via-indigo-950 to-purple-900 rounded-[2rem] overflow-hidden flex items-center justify-center p-6 sm:p-10 shadow-2xl">
    <div class="bg-white rounded-3xl shadow-2xl p-8 sm:p-10 w-full max-w-md text-center">
      <h1 class="text-3xl font-extrabold text-gray-900 mb-3 tracking-tight">What do you think?</h1>
      <p class="text-gray-500 mb-8">Your opinion matters. Share your experience!</p>

      <% if flash[:notice] %>
        <div class="bg-green-50 border border-green-200 text-green-700 rounded-xl p-4 mb-5 font-medium text-sm"><%= flash[:notice] %></div>
      <% end %>

      <% if flash[:alert] %>
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl p-4 mb-5 font-medium text-sm"><%= flash[:alert] %></div>
      <% end %>

      <%= form_with url: votes_path, method: :post do %>
        <div class="space-y-4">
          <%= button_tag type: "submit", name: "vote[choice]", value: "Loved It", class: "group w-full flex items-center justify-between bg-gradient-to-r from-rose-500 to-red-500 hover:from-rose-600 hover:to-red-600 text-white font-bold px-6 py-5 rounded-2xl transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-1" do %>
            <span class="flex items-center gap-4"><span class="text-3xl group-hover:scale-125 transition-transform">❤️</span><span class="text-lg">Loved It</span></span>
            <span class="text-xl opacity-70">→</span>
          <% end %>

          <%= button_tag type: "submit", name: "vote[choice]", value: "Liked It", class: "group w-full flex items-center justify-between bg-gradient-to-r from-blue-500 to-indigo-500 hover:from-blue-600 hover:to-indigo-600 text-white font-bold px-6 py-5 rounded-2xl transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-1" do %>
            <span class="flex items-center gap-4"><span class="text-3xl group-hover:scale-125 transition-transform">👍</span><span class="text-lg">Liked It</span></span>
            <span class="text-xl opacity-70">→</span>
          <% end %>

          <%= button_tag type: "submit", name: "vote[choice]", value: "Tried It", class: "group w-full flex items-center justify-between bg-gradient-to-r from-emerald-500 to-green-500 hover:from-emerald-600 hover:to-green-600 text-white font-bold px-6 py-5 rounded-2xl transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-1" do %>
            <span class="flex items-center gap-4"><span class="text-3xl group-hover:scale-125 transition-transform">😊</span><span class="text-lg">Tried It</span></span>
            <span class="text-xl opacity-70">→</span>
          <% end %>
        </div>
      <% end %>

      <div class="border-t border-gray-100 mt-9 pt-7">
        <div class="flex items-center justify-between mb-7">
          <div class="text-left">
            <h2 class="text-xl font-extrabold text-gray-900">Voting Results</h2>
            <p class="text-xs text-gray-400 mt-1">Community feedback</p>
          </div>

          <div class="bg-indigo-50 border border-indigo-100 rounded-2xl px-5 py-3">
            <p class="text-2xl font-extrabold text-indigo-600"><%= @total_votes %></p>
            <p class="text-xs text-indigo-500 font-semibold">Total Votes</p>
          </div>
        </div>

        <div class="space-y-6 text-sm">
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="font-semibold text-gray-700">❤️ Loved It</span>
              <span class="font-bold text-gray-900"><%= @votes_count["Loved It"] || 0 %> <span class="text-gray-400 font-normal">votes</span></span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-3 overflow-hidden">
              <div class="bg-gradient-to-r from-rose-400 to-red-500 h-3 rounded-full transition-all duration-700" style="width: <%= @total_votes.zero? ? 0 : (@votes_count["Loved It"].to_f / @total_votes * 100) %>%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="font-semibold text-gray-700">👍 Liked It</span>
              <span class="font-bold text-gray-900"><%= @votes_count["Liked It"] || 0 %> <span class="text-gray-400 font-normal">votes</span></span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-3 overflow-hidden">
              <div class="bg-gradient-to-r from-blue-400 to-indigo-500 h-3 rounded-full transition-all duration-700" style="width: <%= @total_votes.zero? ? 0 : (@votes_count["Liked It"].to_f / @total_votes * 100) %>%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="font-semibold text-gray-700">😊 Tried It</span>
              <span class="font-bold text-gray-900"><%= @votes_count["Tried It"] || 0 %> <span class="text-gray-400 font-normal">votes</span></span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-3 overflow-hidden">
              <div class="bg-gradient-to-r from-emerald-400 to-green-500 h-3 rounded-full transition-all duration-700" style="width: <%= @total_votes.zero? ? 0 : (@votes_count["Tried It"].to_f / @total_votes * 100) %>%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

