<div class="min-h-screen w-full bg-indigo-400 flex items-center justify-center p-6">
  <div class="bg-white rounded-2xl shadow-xl p-8 w-full max-w-md text-center">
    <h1 class="text-3xl font-extrabold text-gray-800 mb-3">What do you think?</h1>
    <p class="text-gray-500 mb-8">Choose your experience below.</p>
    <% if flash[:notice] %>
      <div class="bg-green-100 text-green-700 rounded-lg p-3 mb-5"><%= flash[:notice] %></div>
    <% end %>

    <% if flash[:alert] %>
      <div class="bg-red-100 text-red-700 rounded-lg p-3 mb-5"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with url: votes_path, method: :post do %>
      <div class="space-y-3">
        <%= button_tag "❤️ Loved It", type: "submit", name: "vote[choice]", value: "Loved It", class: "w-full bg-red-600 hover:bg-red-700 text-white font-bold py-4 rounded-xl transition duration-200 shadow-sm" %>

        <%= button_tag "👍 Liked It", type: "submit", name: "vote[choice]", value: "Liked It", class: "w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-4 rounded-xl transition duration-200 shadow-sm" %>

        <%= button_tag "😊 Tried It", type: "submit", name: "vote[choice]", value: "Tried It", class: "w-full bg-green-500 hover:bg-green-600 text-white font-bold py-4 rounded-xl transition duration-200 shadow-sm" %>
      </div>
    <% end %>

    <div class="border-t border-gray-300 mt-7 pt-6">
      <h2 class="text-xl font-bold text-gray-800 mb-5">Voting Results</h2>
      <p class="text-gray-500 mb-5">Total Votes:<span class="font-bold text-gray-800"><%= @total_votes %></span></p>
      <div class="space-y-4 text-sm">
        <div class="flex justify-between">
          <span>❤️ Loved It</span>
          <span class="font-bold"><%= @votes_count["Loved It"] || 0 %></span>
        </div>

        <div class="flex justify-between">
          <span>👍 Liked It</span>
          <span class="font-bold"><%= @votes_count["Liked It"] || 0 %></span>
        </div>

        <div class="flex justify-between">
          <span>😊 Tried It</span>
          <span class="font-bold"><%= @votes_count["Tried It"] || 0 %></span>
        </div>
      </div>
    </div>
  </div>
</div>

